{
  "name": "suomynona-council",
  "productName": "Suomynona Council",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "build:master": "node scripts/build-desktop-server.mjs --edition=master",
    "build:client": "node scripts/build-desktop-server.mjs --edition=client",
    "dist:master": "node scripts/build-editions.mjs master",
    "dist:client": "node scripts/build-editions.mjs client",
    "dist:both": "node scripts/build-editions.mjs both",
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build",
    "build:server": "node scripts/build-desktop-server.mjs",
    "build:desktop": "vite build && node scripts/build-desktop-server.mjs",
    "preview": "vite preview",
    "desktop": "npm run build:desktop && electron .",
    "pack:win": "npm run build:desktop && electron-builder --win dir",
    "dist:win": "npm run build:desktop && electron-builder --win portable dir",
    "clean": "node -e \"['dist','dist-server','server.js','dist-native'].forEach(p=>require('fs').rmSync(p,{recursive:true,force:true}))\"",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3": "^7.4.3",
    "@vitejs/plugin-react": "^6.1.1",
    "d3": "^7.9.2",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.0",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "com.suomynona.council",
    "productName": "Suomynona Council",
    "asar": false,
    "directories": {
      "output": "dist-native"
    },
    "win": {
      "target": [
        "portable",
        "dir"
      ],
      "signAndEditExecutable": false,
      "requestedExecutionLevel": "asInvoker"
    },
    "portable": {
      "artifactName": "Suomynona-Council-Portable.exe"
    },
    "files": [
      "electron-main.cjs",
      "preload.cjs",
      "index.js",
      "index.html",
      "desktop-repo-config.json",
      "dist/**/*",
      "dist-server/**/*",
      "public/**/*",
      "src/council_catalog.json",
      "src/data/**/*",
      ".env.example",
      "package.json",
      "!node_modules/**/*"
    ]
  }
}
