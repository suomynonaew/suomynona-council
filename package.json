{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "desktop": "electron .",
    "pack:win": "electron-builder --dir",
    "dist:win": "electron-builder --win portable",
    "clean": "node -e \"['dist','server.js','dist-native'].forEach(p=>require('fs').rmSync(p,{recursive:true,force:true}))\"",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3": "^7.4.3",
    "@vitejs/plugin-react": "^6.1.1",
    "d3": "^7.9.2",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  },
  "build": {
    "appId": "com.suomynona.council",
    "productName": "Suomynona Council",
    "directories": {
      "output": "dist-native"
    },
    "win": {
      "target": [
        "portable"
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "portable": {
      "artifactName": "Suomynona-Council-Portable.exe"
    },
    "files": [
      "dist/**/*",
      "public/**/*",
      "server.ts",
      "server/**/*",
      "guardian_claude_code.ts",
      "src/**/*",
      "index.js",
      "electron-main.cjs",
      "preload.cjs",
      ".council_data/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "index.js"
    }
  }
}
